35\u043c \u043e\u043a\u043e\u043b\u043e \u043e\u0442\u0435\u043b\u044f, \u0442\u0430\u043a \u0447\u0442\u043e \u043d\u0430\u043c \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0435\u0445\u0430\u0442\u044c \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0443 \u043d\u0430 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435. \u0412 \u043e\u0431\u0449\u0435\u043c, \u043e\u043d \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0445\u043e\u0440\u043e\u0448\u043e \u0441\u0435\u0431\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442, \u0447\u0442\u043e\u0431\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0436\u0435 \u043f\u043e\u0435\u0445\u0430\u0442\u044c \u043e\u0431\u0440\u0430\u0442\u043d\u043e, \u0442\u0430\u043a \u0447\u0442\u043e \u043c\u044b \u043e\u0441\u0442\u0430\u043d\u0435\u043c\u0441\u044f \u0435\u0449\u0435 \u043d\u0430 \u043e\u0434\u0438\u043d \u0434\u0435\u043d\u044c. \u0411\u043e\u043b\u044c\u0448\u043e\u0435 \u0442\u0435\u0431\u0435 \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u043f\u0440\u0438\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0448\u044c \u0437\u0430 \u041a\u043b\u0435\u043c\u0435\u043d\u0442\u0438\u043d\u043e\u0439, \u0438 \u044f \u043e\u0431\u0435\u0449\u0430\u044e, \u043c\u044b \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u043e \u0442\u0432\u043e\u0438\u0445 \u0432\u0435\u0441\u0435\u043d\u043d\u0438\u0445 \u043a\u0430\u043d\u0438\u043a\u0443\u043b!\r"},{"file_id":"308314133","pers":"ANSWERING MACHINE\r","text":"\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432\u0442\u043e\u0440\u043e\u0435. \u041e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 23:19.\r"},{"file_id":"308314134","pers":"MOM\r","text":"\u0411\u043e\u0436\u0435 \u043c\u043e\u0439, \u043d\u0443 \u043d\u0430\u043a\u043e\u043d\u0435\u0446-\u0442\u043e! \u042f \u043d\u0435 \u0437\u043d\u0430\u044e, \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c \u043b\u0438 \u0442\u044b \u0441\u0432\u044f\u0437\u0430\u0442\u044c\u0441\u044f \u0441 \u043d\u0430\u043c\u0438 - \u043d\u0438 \u043e\u0434\u0438\u043d \u0437\u0432\u043e\u043d\u043e\u043a \u043d\u0435 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442. \u041e\u043d\u0438 \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u043d\u0430\u043c \u0443\u0435\u0445\u0430\u0442\u044c \u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043e\u0431 \u0410\u0442\u043b\u0430\u043d\u0442\u0435. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0443\u0435\u0437\u0436\u0430\u0439\u0442\u0435 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041a\u043b\u0435\u043c\u0435\u043d\u0442\u0438\u043d\u043e\u0439 \u0438\u0437 \u0433\u043e\u0440\u043e\u0434\u0430, \u0432 \u041c\u0430\u0440\u0438\u0435\u0442\u0442\u0443. \u041c\u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0443. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0434\u0430\u0439 \u043c\u043d\u0435 \u0437\u043d\u0430\u0442\u044c, \u0432\u0441\u0435 \u043b\u0438 \u0443 \u0432\u0430\u0441 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e.\r"},{"file_id":"308314135","pers":"ANSWERING MACHINE\r","text":"\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0442\u0440\u0435\u0442\u044c\u0435. \u041e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 06:51.\r"},{"file_id":"308314136","pers":"MOM\r","text":"\u041a\u043b\u0435\u043c\u0435\u043d\u0442\u0438\u043d\u0430? \u0414\u0435\u0442\u043a\u0430, \u0435\u0441\u043b\u0438 \u0442\u044b \u0441\u043b\u044b\u0448\u0438\u0448\u044c \u044d\u0442\u043e, \u043f\u043e\u0437\u0432\u043e\u043d\u0438 \u0432 \u043f\u043e\u043b\u0438\u0446\u0438\u044e. 9-1-1. \u041c\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u043c \u043b\u044e\u0431\u0438\u0442\u044c \u0442\u0435...\r"},{"file_id":"308314138","pers":"ANSWERING MACHINE\r","text":"\u041d\u0435\u0442 \u043d\u043e\u0432\u044b\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439.\r"}]