43c, \u043a\u0430\u043a \u043f\u043b\u043e\u0445\u0438 \u0435\u0433\u043e \u0434\u0435\u043b\u0430, \u043e\u0431\u043e \u0432\u0441\u0435\u043c \u0442\u043e\u043c, \u0447\u0442\u043e \u043e\u043d\u0438 \u0442\u0430\u043c \u0431\u0443\u0434\u0443\u0442 \u0441 \u043d\u0438\u043c \u0434\u0435\u043b\u0430\u0442\u044c \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 50-75 \u043b\u0435\u0442 \u0435\u0433\u043e \u043d\u0438\u043a\u0447\u0435\u043c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438. \u0418 \u0441\u043a\u0430\u0436\u0443 \u0447\u0435\u0441\u0442\u043d\u043e, \u0437\u0430 \u0432\u0441\u044e \u0441\u0432\u043e\u044e \u0436\u0438\u0437\u043d\u044c, \u044f \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0432\u0438\u0434\u0435\u043b \u0442\u0430\u043a\u043e\u0433\u043e \u043d\u0430\u043f\u0443\u0433\u0430\u043d\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.\r"},{"file_id":"308469838","pers":"\r","text":"\u0421\u041c\u041e\u0422\u0420\u0418 \u0412\u041f\u0415\u0420\u0415\u0414!\r"},{"file_id":"308469839","pers":"\r","text":"\u0412\u041e\u0422 \u0414\u0415\u0420\u042c\u041c\u041e!\r"},{"file_id":"308469840","pers":"\r","text":"\u041d\u0410 \u0414\u041e\u0420\u041e\u0413\u0415!\r"},{"file_id":"308469841","pers":"\r","text":"\u0415\u0411\u0410\u041d\u042b\u0419 \u0412\u041e\u0414\u0418\u041b\u0410!\r"},{"file_id":"308469842","pers":"COP RADIO\r","text":"\u041d\u0430\u043c \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0438 \u043e \u0431\u0435\u0441\u043f\u043e\u0440\u044f\u0434\u043a\u0430\u0445, \u043a\u043e\u0434 10-91E, \u0448\u043e\u0441\u0441\u0435 \u041f\u0438\u0447\u0442\u0440\u0438 285. \u0412\u0441\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0438 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 \u043f\u0440\u043e\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u043d\u0430 \u043c\u0435\u0441\u0442\u043e.\r"},{"file_id":"308469843