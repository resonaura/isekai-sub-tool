<Window x:Class="IsekaiSubTool_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IsekaiSubTool_WPF"
        mc:Ignorable="d"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        BorderThickness="0"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:flipView="https://github.com/JohanLarsson/Gu.Wpf.FlipView"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="IsekaiSubTool WPF" Height="450" Width="800" Background="White" Style="{DynamicResource WStyle}">
    <Window.Resources>
        <SolidColorBrush x:Key="TabItem.Selected.Background" Color="Transparent"/>
        <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#ACACAC"/>
        <Style x:Key="MainTabStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource TabItem.Selected.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TabItem.Selected.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid x:Name="templateRoot" ClipToBounds="true" SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColumnDefinition0"/>
                                <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                                <RowDefinition x:Name="RowDefinition1" Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="headerPanel" Visibility="Collapsed" Background="Transparent" Grid.Column="0" IsItemsHost="true" Margin="2,2,2,0" Grid.Row="0" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
                            <Border x:Name="contentPanel" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TabStripPlacement" Value="Bottom">
                                <Setter Property="Grid.Row" TargetName="headerPanel" Value="1"/>
                                <Setter Property="Grid.Row" TargetName="contentPanel" Value="0"/>
                                <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition1" Value="Auto"/>
                                <Setter Property="Margin" TargetName="headerPanel" Value="2,0,2,2"/>
                            </Trigger>
                            <Trigger Property="TabStripPlacement" Value="Left">
                                <Setter Property="Grid.Row" TargetName="headerPanel" Value="0"/>
                                <Setter Property="Grid.Row" TargetName="contentPanel" Value="0"/>
                                <Setter Property="Grid.Column" TargetName="headerPanel" Value="0"/>
                                <Setter Property="Grid.Column" TargetName="contentPanel" Value="1"/>
                                <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto"/>
                                <Setter Property="Width" TargetName="ColumnDefinition1" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                <Setter Property="Margin" TargetName="headerPanel" Value="2,2,0,2"/>
                            </Trigger>
                            <Trigger Property="TabStripPlacement" Value="Right">
                                <Setter Property="Grid.Row" TargetName="headerPanel" Value="0"/>
                                <Setter Property="Grid.Row" TargetName="contentPanel" Value="0"/>
                                <Setter Property="Grid.Column" TargetName="headerPanel" Value="1"/>
                                <Setter Property="Grid.Column" TargetName="contentPanel" Value="0"/>
                                <Setter Property="Width" TargetName="ColumnDefinition0" Value="*"/>
                                <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto"/>
                                <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                <Setter Property="Margin" TargetName="headerPanel" Value="0,2,2,2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="TextElement.Foreground" TargetName="templateRoot" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="WindowTemplateKey" TargetType="{x:Type Window}">
            <Border BorderBrush="#222" BorderThickness="0" Background="#222">
                <Grid>
                    <AdornerDecorator>
                        <ContentPresenter/>
                    </AdornerDecorator>
                    <ResizeGrip x:Name="WindowResizeGrip" BorderBrush="#111" Background="#222" HorizontalAlignment="Right" IsTabStop="false" Visibility="Collapsed" VerticalAlignment="Bottom" BorderThickness="0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                        <Condition Property="WindowState" Value="Normal"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Visibility" TargetName="WindowResizeGrip" Value="Visible"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="WStyle" TargetType="{x:Type Window}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Window}">
                        <Border BorderBrush="#222" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <AdornerDecorator>
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                    <Setter Property="Template" Value="{StaticResource WindowTemplateKey}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlipViewStyle1" TargetType="{x:Type flipView:FlipView}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ShowIndex" Value="False"/>
            <Setter Property="IndexItemStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Margin" Value="12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Ellipse x:Name="Bd" Fill="Transparent" Height="20" Margin="{TemplateBinding Padding}" Stroke="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" StrokeThickness="1" Width="20"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Fill" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ShowArrows" Value="True"/>
            <Setter Property="ArrowPlacement" Value="Inside"/>
            <Setter Property="ArrowButtonStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type RepeatButton}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="IsManipulationEnabled" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Grid>
                                        <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                                        <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding Content}" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="IncreaseInAnimation">
                <Setter.Value>
                    <Storyboard>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="0" To="1" Storyboard.TargetProperty="Opacity"/>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="1" To="0" Storyboard.TargetProperty="(flipView:Transform.RelativeOffsetX)"/>
                    </Storyboard>
                </Setter.Value>
            </Setter>
            <Setter Property="IncreaseOutAnimation">
                <Setter.Value>
                    <Storyboard>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="1" To="0" Storyboard.TargetProperty="Opacity"/>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="0" To="-1" Storyboard.TargetProperty="(flipView:Transform.RelativeOffsetX)"/>
                    </Storyboard>
                </Setter.Value>
            </Setter>
            <Setter Property="DecreaseInAnimation">
                <Setter.Value>
                    <Storyboard>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="0" To="1" Storyboard.TargetProperty="Opacity"/>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="-1" To="0" Storyboard.TargetProperty="(flipView:Transform.RelativeOffsetX)"/>
                    </Storyboard>
                </Setter.Value>
            </Setter>
            <Setter Property="DecreaseOutAnimation">
                <Setter.Value>
                    <Storyboard>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="1" To="0" Storyboard.TargetProperty="Opacity"/>
                        <DoubleAnimation BeginTime="0" Duration="0:0:0.3" FillBehavior="Stop" From="0" To="1" Storyboard.TargetProperty="(flipView:Transform.RelativeOffsetX)"/>
                    </Storyboard>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type flipView:FlipView}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="Index" BorderThickness="0" Background="Transparent" Grid.ColumnSpan="3" Grid.Column="0" HorizontalAlignment="Center" ItemContainerStyle="{TemplateBinding IndexItemStyle}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid HorizontalAlignment="Center" IsItemsHost="True" Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Style>
                                        <Style TargetType="{x:Type ListBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IndexPlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Above">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IndexPlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Below">
                                                    <Setter Property="Grid.Row" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="{x:Type ListBox}">
                                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                </ListBox>
                                <Border x:Name="LeftArrow" Grid.Row="1">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Grid.Column" Value="1"/>
                                            <Style.BasedOn>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Panel.ZIndex" Value="100"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="{x:Null}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowArrows, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type flipView:FlipView}}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowArrows, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type flipView:FlipView}}}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Style.BasedOn>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ArrowPlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Inside">
                                                    <Setter Property="Grid.Column" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ArrowPlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Outside">
                                                    <Setter Property="Grid.Column" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RepeatButton x:Name="BrowseBackButton" Command="NavigationCommands.BrowseBack" HorizontalAlignment="Left" Style="{TemplateBinding ArrowButtonStyle}">
                                        <Path Data="F1M35.8724,37.6042L39.0391,40.7708 50.5182,51.8542 40.2266,51.8542 25.1849,37.6041 40.2266,23.3542 50.5182,23.3542 39.0391,34.4375 35.8724,37.6042z">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Width" Value="16"/>
                                                    <Setter Property="Height" Value="16"/>
                                                    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Stretch" Value="Fill"/>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </RepeatButton>
                                </Border>
                                <Border x:Name="RightArrow" Grid.Row="1">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Grid.Column" Value="1"/>
                                            <Style.BasedOn>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Panel.ZIndex" Value="100"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="{x:Null}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowArrows, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type flipView:FlipView}}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShowArrows, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type flipView:FlipView}}}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Style.BasedOn>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ArrowPlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Inside">
                                                    <Setter Property="Grid.Column" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ArrowPlacement, RelativeSource={RelativeSource TemplatedParent}}" Value="Outside">
                                                    <Setter Property="Grid.Column" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <RepeatButton x:Name="BrowseForwardButton" Command="NavigationCommands.BrowseForward" HorizontalAlignment="Right" Style="{TemplateBinding ArrowButtonStyle}">
                                        <Path Data="F1M39.8307,37.6042L36.6641,34.4375 25.1849,23.3542 35.4766,23.3542 50.5182,37.6042 35.4766,51.8542 25.1849,51.8542 36.6641,40.7708 39.8307,37.6042z">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Width" Value="16"/>
                                                    <Setter Property="Height" Value="16"/>
                                                    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Stretch" Value="Fill"/>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </RepeatButton>
                                </Border>
                                <flipView:GesturePanel x:Name="GesturePanel" Background="Transparent" Grid.Column="1" Grid.Row="1">
                                    <flipView:GesturePanel.GestureTracker>
                                        <flipView:TouchGestureTracker>
                                            <flipView:TouchGestureTracker.Interpreter>
                                                <flipView:DefaultGestureInterpreter/>
                                            </flipView:TouchGestureTracker.Interpreter>
                                        </flipView:TouchGestureTracker>
                                    </flipView:GesturePanel.GestureTracker>
                                    <flipView:TransitionControl x:Name="TransitionControl" ContentTemplate="{TemplateBinding ItemTemplate}" Content="{TemplateBinding SelectedItem}" ContentStringFormat="{TemplateBinding ItemStringFormat}" InAnimation="{TemplateBinding CurrentOutAnimation}" OutAnimation="{TemplateBinding CurrentInAnimation}"/>
                                </flipView:GesturePanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <materialDesign:ColorZone
  Mode="Light"  HorizontalAlignment="Stretch">
                    <Grid>
                        <StackPanel
  Orientation="Horizontal"
  Margin="0">
                            <RadioButton
    Style="{StaticResource MaterialDesignTabRadioButton}"
    Margin="4"
                    Name="ChButton"
                    Click="ChButton_Click"
                    Width="180"
    IsChecked="True"
     >
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock VerticalAlignment="Center">ПО ГЛАВАМ</TextBlock>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
    Style="{StaticResource MaterialDesignTabRadioButton}"
    Margin="4"
                    Name="PersButton"
                        Click="PersButton_Click"
    IsChecked="False"
                    Width="180">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CommentUser" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock VerticalAlignment="Center">ПО ПЕРСОНАЖАМ</TextBlock>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                    </Grid>
                </materialDesign:ColorZone>
            </Grid>

            <TabControl x:Name="MainTab" SelectedIndex="0" Grid.Row="1" Style="{DynamicResource MainTabStyle}">
                <TabItem Header="По главам">

                    <Grid>
                        <flipView:FlipView Name="ChFlip" Style="{DynamicResource FlipViewStyle1}">
                            <flipView:FlipView.Items>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp"  Img="data/102a.png" Header="Глава 1: Долгая поездка домай"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102b.png" Header="Глава 1: Лес"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102c.png" Header="Глава 2: Во дворе"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102d.png" Header="Глава 3: Встреча Клементины"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102e.png" Header="Глава 4: Ферма Хершела"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102f.png" Header="Глава 4: Шон или Дак"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102g.png" Header="Глава 5: Ну вот и дома"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102h.png" Header="Глава 5: Нападение на Клем"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102i.png" Header="Глава 5: Motor Inn"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102j.png" Header="Глава 5: The Girl in Room 9"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102k.png" Header="Глава 6: Брат"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102l.png" Header="Глава 7: Даг или Карли"></local:Chapter>
                                </Grid>
                                <Grid>
                                    <local:Chapter MouseUp="Chapter_MouseUp" Img="data/102m.png" Header="Глава 8: Спасены... Почти"></local:Chapter>
                                </Grid>
                            </flipView:FlipView.Items>
                        </flipView:FlipView>
                        <local:SubTitlePanel x:Name="SP1" Visibility="Collapsed"></local:SubTitlePanel>
                    </Grid>

                </TabItem>
                <TabItem Header="По персонажам">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Name="PersWrapper">
                            <StackPanel Orientation="Vertical">
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Ли" Persen="LEE" ISource="data/pers/LEE.jpg" IText="Личность Ли полностью зависит от принятых игроком решений на протяжении всей игры. Он может либо вселять в людей надежду и немного идеалистического образа, часто даёт людям благо сомнения и сомнение в необходимости выполнения нравственно сомнительных действий, либо будет достаточно прагматичным человеком, который показывает признаки агрессии или насилия, если необходимо, в соответствии с напряжёнными ситуациями.Наиболее очевидная черта Ли, отображённая на протяжении всей серии, является способность быть заботливым и любящим."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Клементина" Persen="CLEMENTINE" ISource="data/pers/CLEMENTINE.jpg" IText="'Эта маленькая девочка - загадка'"></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Шон" Persen="SHAWN" ISource="data/pers/SHAWN.jpg" IText="Шон является старшим сыном Хершела Грина, он добрый, жизнерадостный парень, который знает, что отец его тоже любит. Шон зачастую уверен, что именно он должен делать любую работу на ферме, так как он самый старший."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Митчел" Persen="MITCHELL" ISource="data/pers/MITCHELL.jpg" IText="Ничего не известно о жизни Андре до апокалипсиса, кроме того, что он был офицером полиции."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Марк" Persen="MARK" ISource="data/pers/MARK.jpg" IText="Марк родился в Мейконе, был пилотом, служил на авиабазе Робинс до того, как она была захвачена зомби. Группа встретила его в промежутке между 1-м и 2-м эпизодами. Так как у него был доступ к большим запасам еды и оружия на базе, Лилли позволила ему присоединиться к их группе."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Лилли" Persen="LILLY" ISource="data/pers/LILLY.jpg" IText="Лилли - властная женщина, имеющая способность контролировать группу таким образом, каким она считает нужным. Интересно отметить, что когда Ларри начинает действовать в приступе ярости, она действует как пацифист и пытается его успокоить, но всё проходит безрезультатно. Это показывает, что, в отличие от её отца, у неё нет похожих горечи и негодования, которые имеет Ларри ко всем остальным, хотя у неё есть характер, с которым не будут считаться."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Ларри" Persen="LARRY" ISource="data/pers/LARRY.jpg" IText="Личность Ларри не такая уж плохая, как можно увидеть во время игры. В глубине души Ларри сильно переживает за свою последнюю надежду – Лилли. И, зная, что Ли Эверетт - убийца, не подпускает её к нему. Он старается, чтобы Лилли была счастлива, но при попадании в трудную эмоциональную ситуацию у него может случиться сердечный приступ."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Кэнни" Persen="KENNY" ISource="data/pers/KENNY.jpg" IText="Симпатичный, но резкий, работящий парень, который любит, чтобы всё было так, как решит он, невзирая на мнение остальных членов группы. Кенни в силу основы своего характера просто довольно резок в отношении к людям, что вмешиваются в дела его семьи и близких друзей."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Катя" Persen="KATJAA" ISource="data/pers/KATJAA.jpg" IText="Жена Кенни и матерь Дака,  заботливая женщина и не боится сказать то, что думает. Упорная и настойчивая, Катя является очень сильной опорой и голосом разума для Кенни, когда возникают сложные вопросы. Как мать и домохозяйка средних лет в группе, Катя была одной из персонажей игры, чья личность переживает радикальные изменения в связи с событиями, которые происходят."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Хершель" Persen="HERSHEL" ISource="data/pers/HERSHEL.jpg" IText="Мало известно о Хершеле до вспышки инфекции. Известно лишь, что он бывший ветеринар. Когда-то он был семейным человеком, который владел фермой. Его старший сын Шон также появлялся в видеоигре."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Гленн" Persen="GLENN" ISource="data/pers/GLENN.jpg" IText="Почти ничего не известно о жизни Гленна до начала нашествия зомби, кроме того, что он работал развозчиком пиццы"></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Дак" Persen="DUCK" ISource="data/pers/DUCK.jpg" IText="Характер Дака (в отличие от Клементины) ещё не сформирован. Он капризен и пытлив. Создаётся ощущение, что он не до конца понимает всю тяжесть ситуации."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Даг" Persen="DOUG" ISource="data/pers/DOUG.jpg" IText="Даг был программистом. За два месяца до апокалипсиса он приехал в Мейкон и жил со своим дядей. Даг спас Карли, когда её и её начальницу атаковали ходячие."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Дэвид" Persen="DAVID" ISource="data/pers/DAVID.jpg" IText="Дэвид Паркер - преподаватель в школе, где учились Бен Пол и Трэвис. Ещё он является руководителем школьного оркестра, в котором состоят Бен и Трэвис."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Коп" Persen="COP" ISource="data/pers/COP.jpg" IText="Просто коп"></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Чет" Persen="CHET" ISource="data/pers/CHET.jpg" IText="До вспышки эпидемии Чет жил рядом с фермой семьи Хершела вместе со своей матерью и дружил с Шоном Грином."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Карли" Persen="CARLEY" ISource="data/pers/CARLEY.jpg" IText="Карли впервые появляется как серьёзный журналист, который вместе с Гленном решает спасти Ли и семью Кенни по их прибытию в Мейкон. Проведя время в районах боевых действий в качестве корреспондента, она, по-видимому, приобретает основные знания об огнестрельном оружии и тактике выживания, что позволило ей выжить во время заражения. Её точность при обращении с оружием часто замечается Кенни как 'dead eye accuracy'."></local:PersListItem>
                                <local:PersListItem MouseUp="PersListItem_MouseUp" IHeader="Энди" Persen="ANDY" ISource="data/pers/ANDY.jpg" IText=""></local:PersListItem>
                            </StackPanel>
                        </ScrollViewer>
                        <local:SubTitlePanel x:Name="SP2" Visibility="Collapsed"></local:SubTitlePanel>
                    </Grid>
                    
                    
                </TabItem>
            </TabControl>

        </Grid>
