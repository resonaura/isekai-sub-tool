<UserControl x:Class="IsekaiSubTool_WPF.Chapter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IsekaiSubTool_WPF"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <materialDesign:Card VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                </Grid.RowDefinitions>
                <Image x:Name="ChImg" Source="{Binding Img}" Grid.Row="0" Stretch="UniformToFill"></Image>
                <TextBlock Grid.Row="1" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Header}"></TextBlock>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
