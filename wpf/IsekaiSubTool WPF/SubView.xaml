<Window x:Class="IsekaiSubTool_WPF.SubView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IsekaiSubTool_WPF"
        mc:Ignorable="d"
        Title="SubView" Height="450" Width="800">
    <Grid Margin="30">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock TextAlignment="Center" FontSize="18" Opacity=".5" Name="MainHeader"></TextBlock>
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Name="MainText" FontSize="36">Выберите субтитр</TextBlock>
        </StackPanel>

    </Grid>
</Window>
