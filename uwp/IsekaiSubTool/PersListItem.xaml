<UserControl
    x:Class="IsekaiSubTool.PersListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:IsekaiSubTool"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="1000" Height="300" Margin="0,0,10,0" HorizontalAlignment="Stretch">

    <Button Background="Transparent" Style="{ThemeResource ButtonRevealStyle}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
        <Grid Height="300" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image x:Name="Poster" Stretch="UniformToFill" Source="{Binding Source}"></Image>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DHeader" Padding="20,0,0,0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="36">Имя персонажа</TextBlock>
                <TextBlock TextWrapping="Wrap" x:Name="DBox" Padding="20,0,0,0" Grid.Row="1" FontSize="16">Описание персонажа</TextBlock>
            </Grid>
        </Grid>
    </Button>
    
</UserControl>
